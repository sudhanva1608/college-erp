# ============================================================
# LOCAL DEVELOPER CONFIGURATION
# Copy this file to .env and adjust for your machine.
# .env is gitignored — never commit it.
# ============================================================

# DB_PORT: Port that Docker maps PostgreSQL to on your HOST machine.
#
#   Mac users        → use 5432 (default, no local PG conflict)
#   Windows users    → use 5433 (if local PostgreSQL is already on 5432)
#
DB_PORT=5432
