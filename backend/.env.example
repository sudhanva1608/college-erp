# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL via Docker)
# ⚠️  DO NOT edit this manually.
# This file is auto-generated by `npm run db:start` based on DB_PORT in the root .env
# Mac users   → root .env has DB_PORT=5432
# Windows users → root .env has DB_PORT=5433 (if local PG is on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_erp?schema=public"

# Authentication (JWT)
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"
